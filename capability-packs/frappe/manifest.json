{
  "schemaVersion": 1,
  "id": "frappe-federated-bridge",
  "name": "Frappe/ERPNext Federated Bridge",
  "version": "0.1.0",
  "kind": "tool",
  "entrypoint": "dist/index.js",
  "permissions": [
    "network",
    "secrets"
  ],
  "sandbox": "network_limited",
  "secrets": [
    "FRAPPE_SITE_URL",
    "FRAPPE_API_TOKEN",
    "FRAPPE_APPROVAL_SIGNING_KEY",
    "FRAPPE_BUSINESS_API_CATALOG",
    "FRAPPE_READ_MODEL_PATH"
  ],
  "evals": [
    "evals/identity-resolution.json",
    "evals/permission-scoping.json"
  ],
  "digest": "sha256:145bc3a0c0cd00231774b3e1062cd8243cda279e9efcf96ebb164cd6331d18f9",
  "description": "Permission-scoped Frappe/ERPNext tools with federated OAuth identity and an executable enterprise read model. Frappe remains the authorization authority. SQLite provides local/test persistence while the Postgres deployment contract preserves the same site, principal, permission-epoch, and revision boundaries. Customer deployments are data-only profiles; no customer-specific answers live in the pack code.",
  "implementedTools": [
    "frappe_identity_resolve",
    "frappe_user_identity_resolve",
    "frappe_semantic_data_resolve_lite",
    "frappe_docs_context",
    "frappe_context_setup_plan",
    "frappe_context_build",
    "frappe_installed_context",
    "frappe_module_context",
    "frappe_site_induction",
    "frappe_query_classify",
    "frappe_hybrid_retrieve",
    "frappe_read_model_plan",
    "frappe_fast_route",
    "frappe_chat_interaction_plan",
    "frappe_permission_check",
    "frappe_safe_write",
    "frappe_artifact_brief",
    "frappe_enterprise_contract",
    "frappe_enterprise_sync",
    "frappe_customer_profile_validate",
    "frappe_hierarchy_scope"
  ],
  "plannedTools": [
    "frappe_customization_context",
    "frappe_semantic_data_resolve",
    "frappe_records_update",
    "frappe_dataset_fetch_for_artifact"
  ],
  "status": "beta: permission-scoped REST/OAuth polling and governed CRUD/workflow writes through frappe_safe_write. Writes require live Frappe permission checks, short-lived one-use mutation-bound approval receipts, expected_modified for existing records, idempotency keys, and postcondition verification. Unsupported behavior is returned explicitly; Frappe remains the authorization authority.",
  "readiness": {
    "level": "verified",
    "status": "beta",
    "actionability": "local_tool",
    "owner": "muster-core",
    "surfaces": [
      "cli",
      "frappe"
    ],
    "setup": {
      "urls": [
        "https://frappeframework.com/docs/user/en/api/rest",
        "https://docs.erpnext.com/",
        "https://frappeframework.com/docs"
      ],
      "requiredEnv": [
        "FRAPPE_SITE_URL",
        "FRAPPE_API_TOKEN"
      ],
      "requiredAnyEnv": [],
      "credentialStorage": "env",
      "notes": [
        "FRAPPE_APPROVAL_SIGNING_KEY and FRAPPE_READ_MODEL_PATH are required only when executing bound write approvals.",
        "OAuth token providers can supply user access tokens to the zero-app poller without persisting tokens in the read model.",
        "profiles/oxygenhr.sanitized.json is example deployment data, not customer-specific code."
      ]
    },
    "diagnostics": {
      "doctorCommand": "muster plugins check frappe-federated-bridge",
      "smokeCommand": "muster capability inspect capability-packs/frappe",
      "latencyBudgetMs": 3000,
      "requiresLiveCredentials": true
    },
    "safety": {
      "risk": "high",
      "permissionMode": "ask",
      "mutationApproval": "required",
      "resultCapBytes": 65536,
      "secretRedaction": true
    },
    "evidence": {
      "unitTests": [
        "packages/core/test/capability-load.test.ts",
        "packages/core/test/capability.test.ts",
        "packages/core/test/frappe-pack.test.ts"
      ],
      "qaSuites": [
        "pack_readiness"
      ],
      "liveArtifacts": [],
      "docs": [
        "FRAPPE_SURFACE_SPEC.md",
        "profiles/customer-profile.schema.json",
        "profiles/oxygenhr.sanitized.json"
      ]
    }
  }
}
