{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://themuster.dev/schemas/video-evidence-1.1.json",
  "title": "Muster Frappeverse Video Evidence Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "generated_at", "clips"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "kind": { "const": "muster-frappeverse-video-evidence" },
    "generated_at": { "type": "string", "format": "date-time" },
    "clips": {
      "type": "array",
      "items": { "$ref": "#/$defs/clip" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id", "product", "outcome", "claim", "actor", "site",
        "build_revision", "routes", "expected_result", "viewport", "timestamps",
        "duration_seconds", "chapters", "coverage_cells", "video", "screenshots",
        "traces", "test_receipts"
      ],
      "properties": {
        "scenario_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$" },
        "product": { "enum": ["muster", "erpnext", "hrms", "crm", "helpdesk", "custom_app"] },
        "outcome": { "enum": ["allow", "deny", "paired"] },
        "claim": { "type": "string", "minLength": 8, "maxLength": 1000 },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "roles"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 254 },
            "roles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 140 }
            }
          }
        },
        "site": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "revision"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 140 },
            "revision": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "build_revision": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
        "routes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/[^\\s]*$", "maxLength": 500 }
        },
        "expected_result": { "type": "string", "minLength": 8, "maxLength": 2000 },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "width", "height"],
          "properties": {
            "class": { "enum": ["desktop", "mobile"] },
            "width": { "type": "integer", "minimum": 240, "maximum": 7680 },
            "height": { "type": "integer", "minimum": 240, "maximum": 7680 }
          }
        },
        "timestamps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["started_at", "finished_at", "basis"],
          "properties": {
            "started_at": { "type": "string", "format": "date-time" },
            "finished_at": { "type": "string", "format": "date-time" },
            "basis": { "const": "filesystem_mtime_minus_ffprobe_duration" }
          }
        },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["runbook_id", "title", "start_seconds", "end_seconds", "claim"],
            "properties": {
              "runbook_id": { "type": "string", "pattern": "^(CFG|MUS|ERP|HRM|CRM|HDK|CUS|SOP|DEV)-[0-9]{2}$" },
              "title": { "type": "string", "minLength": 3, "maxLength": 200 },
              "start_seconds": { "type": "number", "minimum": 0 },
              "end_seconds": { "type": "number", "exclusiveMinimum": 0 },
              "claim": { "type": "string", "minLength": 8, "maxLength": 1000 }
            }
          }
        },
        "coverage_cells": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["product", "viewport", "outcome"],
            "properties": {
              "product": { "enum": ["muster", "erpnext", "hrms", "crm", "helpdesk", "custom_app"] },
              "viewport": { "enum": ["desktop", "mobile"] },
              "outcome": { "enum": ["allow", "deny"] }
            }
          }
        },
        "video": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "bytes", "media_type"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "bytes": { "type": "integer", "minimum": 1 },
            "media_type": { "enum": ["video/mp4", "video/quicktime", "video/webm"] }
          }
        },
        "screenshots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "traces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "test_receipts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    }
  }
}
