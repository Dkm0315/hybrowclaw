Output docs/assets/muster-frappe-linking-demo.mp4

Require node
Require ffmpeg

Set Shell "bash"
Set FontSize 16
Set Width 1280
Set Height 720
Set Padding 18
Set WindowBar Rings
Set TypingSpeed 10ms
Set Framerate 30
Set PlaybackSpeed 1.0

Type "clear"
Enter
Sleep 1s
Type "ssh Frappe-2 '/home/goblin/.local/bin/muster frappe connect https://earl-patrol-commons-uncertainty.trycloudflare.com --muster-url https://component-pictures-geographic-spray.trycloudflare.com --no-open --no-qr --no-wait'"
Enter
Sleep 12s
